{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Cầu Nối Sách – hướng A: Vở ô li (sáng) và Bảng đen (tối). Sửa file này rồi chạy `npm run tokens` để sinh tokens.css.",
  "primitive": {
    "color": {
      "ink": {
        "50": { "$value": "#f1eefa", "$type": "color" },
        "100": { "$value": "#e4def5", "$type": "color" },
        "600": { "$value": "#4a3a8f", "$type": "color" },
        "700": { "$value": "#33246e", "$type": "color" },
        "800": { "$value": "#261a55", "$type": "color" }
      },
      "paper": {
        "white": { "$value": "#ffffff", "$type": "color" },
        "sunken": { "$value": "#f5f4fa", "$type": "color" },
        "rule": { "$value": "#e1e4f3", "$type": "color" },
        "rule-strong": { "$value": "#c6cae7", "$type": "color" }
      },
      "pen": {
        "red": { "$value": "#c0261c", "$type": "color" },
        "red-dark": { "$value": "#9b1d15", "$type": "color" },
        "red-wash": { "$value": "#fcecea", "$type": "color" }
      },
      "leaf": {
        "700": { "$value": "#1c6b44", "$type": "color" },
        "50": { "$value": "#e7f3ec", "$type": "color" }
      },
      "amber": {
        "700": { "$value": "#8a5300", "$type": "color" },
        "400": { "$value": "#c9902a", "$type": "color" },
        "50": { "$value": "#fbf1d9", "$type": "color" }
      },
      "sky": { "600": { "$value": "#2f6fb0", "$type": "color" }, "300": { "$value": "#8fbdf0", "$type": "color" } },
      "text": {
        "strong": { "$value": "#1e1a33", "$type": "color" },
        "muted": { "$value": "#5d5875", "$type": "color" }
      },
      "board": {
        "950": { "$value": "#161f1b", "$type": "color" },
        "900": { "$value": "#1d2823", "$type": "color" },
        "850": { "$value": "#202c26", "$type": "color" },
        "800": { "$value": "#26332d", "$type": "color" },
        "700": { "$value": "#34443c", "$type": "color" },
        "600": { "$value": "#46584f", "$type": "color" }
      },
      "chalk": {
        "white": { "$value": "#ecede6", "$type": "color" },
        "muted": { "$value": "#b2b9ae", "$type": "color" },
        "yellow": { "$value": "#e9d784", "$type": "color" },
        "orange": { "$value": "#f2b872", "$type": "color" },
        "red": { "$value": "#f4998a", "$type": "color" },
        "green": { "$value": "#9fd8b4", "$type": "color" },
        "red-wash": { "$value": "#3a2622", "$type": "color" },
        "green-wash": { "$value": "#1f3a2b", "$type": "color" },
        "orange-wash": { "$value": "#3b2f1f", "$type": "color" },
        "grid": { "$value": "rgba(236, 237, 230, 0.05)", "$type": "color" },
        "grid-strong": { "$value": "rgba(236, 237, 230, 0.08)", "$type": "color" }
      }
    },
    "font": {
      "display": { "$value": "'Literata', Georgia, 'Times New Roman', serif", "$type": "fontFamily" },
      "ui": { "$value": "'Be Vietnam Pro', system-ui, -apple-system, 'Segoe UI', sans-serif", "$type": "fontFamily" }
    },
    "size": {
      "xs": { "$value": "0.8125rem", "$type": "dimension" },
      "sm": { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "1rem", "$type": "dimension" },
      "lg": { "$value": "1.125rem", "$type": "dimension" },
      "xl": { "$value": "1.375rem", "$type": "dimension" },
      "2xl": { "$value": "1.75rem", "$type": "dimension" },
      "3xl": { "$value": "2.25rem", "$type": "dimension" },
      "4xl": { "$value": "3rem", "$type": "dimension" }
    },
    "space": {
      "1": { "$value": "0.25rem", "$type": "dimension" },
      "2": { "$value": "0.5rem", "$type": "dimension" },
      "3": { "$value": "0.75rem", "$type": "dimension" },
      "4": { "$value": "1rem", "$type": "dimension" },
      "5": { "$value": "1.25rem", "$type": "dimension" },
      "6": { "$value": "1.5rem", "$type": "dimension" },
      "8": { "$value": "2rem", "$type": "dimension" },
      "10": { "$value": "2.5rem", "$type": "dimension" },
      "12": { "$value": "3rem", "$type": "dimension" },
      "16": { "$value": "4rem", "$type": "dimension" }
    },
    "radius": {
      "sm": { "$value": "3px", "$type": "dimension" },
      "md": { "$value": "6px", "$type": "dimension" },
      "lg": { "$value": "10px", "$type": "dimension" }
    },
    "duration": {
      "fast": { "$value": "120ms", "$type": "duration" },
      "normal": { "$value": "200ms", "$type": "duration" },
      "slow": { "$value": "320ms", "$type": "duration" }
    }
  },
  "semantic": {
    "color": {
      "bg": { "$value": "{primitive.color.paper.white}" },
      "surface": { "$value": "{primitive.color.paper.white}" },
      "sunken": { "$value": "{primitive.color.paper.sunken}" },
      "text": { "$value": "{primitive.color.text.strong}" },
      "muted": { "$value": "{primitive.color.text.muted}" },
      "primary": { "$value": "{primitive.color.ink.700}" },
      "primary-hover": { "$value": "{primitive.color.ink.800}" },
      "primary-wash": { "$value": "{primitive.color.ink.50}" },
      "on-primary": { "$value": "{primitive.color.paper.white}" },
      "attention": { "$value": "{primitive.color.pen.red}" },
      "attention-hover": { "$value": "{primitive.color.pen.red-dark}" },
      "attention-wash": { "$value": "{primitive.color.pen.red-wash}" },
      "success": { "$value": "{primitive.color.leaf.700}" },
      "success-wash": { "$value": "{primitive.color.leaf.50}" },
      "warning": { "$value": "{primitive.color.amber.700}" },
      "warning-mark": { "$value": "{primitive.color.amber.400}" },
      "warning-wash": { "$value": "{primitive.color.amber.50}" },
      "digital": { "$value": "{primitive.color.sky.600}" },
      "rule": { "$value": "{primitive.color.paper.rule}" },
      "rule-strong": { "$value": "{primitive.color.paper.rule-strong}" },
      "margin": { "$value": "{primitive.color.pen.red}" },
      "focus": { "$value": "{primitive.color.sky.600}" },
      "grid": { "$value": "{primitive.color.paper.rule}" },
      "grid-strong": { "$value": "{primitive.color.paper.rule-strong}" }
    },
    "shadow": {
      "raise": { "$value": "0 1px 0 rgb(51 36 110 / 0.06), 0 10px 30px -12px rgb(51 36 110 / 0.28)" }
    }
  },
  "dark": {
    "semantic": {
      "color": {
        "bg": { "$value": "{primitive.color.board.900}" },
        "surface": { "$value": "{primitive.color.board.850}" },
        "sunken": { "$value": "{primitive.color.board.800}" },
        "text": { "$value": "{primitive.color.chalk.white}" },
        "muted": { "$value": "{primitive.color.chalk.muted}" },
        "primary": { "$value": "{primitive.color.chalk.yellow}" },
        "primary-hover": { "$value": "#f3e3a0" },
        "primary-wash": { "$value": "{primitive.color.board.700}" },
        "on-primary": { "$value": "{primitive.color.board.950}" },
        "attention": { "$value": "{primitive.color.chalk.red}" },
        "attention-hover": { "$value": "#f8b3a7" },
        "attention-wash": { "$value": "{primitive.color.chalk.red-wash}" },
        "success": { "$value": "{primitive.color.chalk.green}" },
        "success-wash": { "$value": "{primitive.color.chalk.green-wash}" },
        "warning": { "$value": "{primitive.color.chalk.orange}" },
        "warning-mark": { "$value": "{primitive.color.chalk.orange}" },
        "warning-wash": { "$value": "{primitive.color.chalk.orange-wash}" },
        "digital": { "$value": "{primitive.color.sky.300}" },
        "rule": { "$value": "{primitive.color.board.700}" },
        "rule-strong": { "$value": "{primitive.color.board.600}" },
        "margin": { "$value": "{primitive.color.chalk.red}" },
        "focus": { "$value": "{primitive.color.sky.300}" },
        "grid": { "$value": "{primitive.color.chalk.grid}" },
        "grid-strong": { "$value": "{primitive.color.chalk.grid-strong}" }
      },
      "shadow": {
        "raise": { "$value": "0 1px 0 rgb(0 0 0 / 0.3), 0 14px 36px -10px rgb(0 0 0 / 0.55)" }
      }
    }
  },
  "component": {
    "button": {
      "height": { "$value": "2.5rem" },
      "height-touch": { "$value": "2.75rem" },
      "radius": { "$value": "var(--primitive-radius-sm)" },
      "primary-bg": { "$value": "var(--color-primary)" },
      "primary-bg-hover": { "$value": "var(--color-primary-hover)" },
      "primary-fg": { "$value": "var(--color-on-primary)" },
      "danger-bg": { "$value": "var(--color-attention)" },
      "danger-bg-hover": { "$value": "var(--color-attention-hover)" }
    },
    "input": {
      "height": { "$value": "2.5rem" },
      "radius": { "$value": "var(--primitive-radius-sm)" },
      "border": { "$value": "var(--color-rule-strong)" },
      "bg": { "$value": "var(--color-surface)" }
    },
    "rail": {
      "width": { "$value": "13.5rem" },
      "bg": { "$value": "var(--color-surface)" }
    },
    "panel": {
      "radius": { "$value": "var(--primitive-radius-md)" },
      "padding": { "$value": "var(--primitive-space-6)" }
    },
    "z": {
      "sticky": { "$value": "10" },
      "drawer": { "$value": "40" },
      "modal": { "$value": "50" },
      "toast": { "$value": "60" }
    }
  }
}
